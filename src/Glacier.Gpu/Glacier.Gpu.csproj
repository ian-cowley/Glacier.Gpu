<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Gpu</PackageId>
    <Version>1.2.1</Version>
    <PackageReleaseNotes>v1.2.1: Updated Glacier.Compute 1.1.1 dependency and GPU driver reliability hardening.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Heterogeneous Bare-Metal GPU Compute Engine in C# .NET 10 with Glacier.Compute foundational integration. Bypasses CUDA runtime to execute raw SASS machine code, multi-slot persistent ring buffer megakernels on non-blocking streams, Direct3D 12 compute shaders, Vulkan compute, and AMD RDNA zero-copy APU unified memory.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Gpu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Gpu.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gpu;cuda;sass;compute;rocm;hip;rdna;vulkan;d3d12;bare-metal;ring-buffer;high-performance;simd;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Gpu.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('../../../Glacier.Compute/src/Glacier.Compute/Glacier.Compute.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <DefineConstants>$(DefineConstants);USE_LOCAL_GLACIER_COMPUTE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../../../Glacier.Compute/src/Glacier.Compute/Glacier.Compute.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Compute/src/Glacier.Compute/Glacier.Compute.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Compute/src/Glacier.Compute/Glacier.Compute.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Compute" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.Direct3D12" />
  </ItemGroup>
</Project>
